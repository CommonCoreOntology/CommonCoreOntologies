    rdfs:domain obo:BFO_0000001 ;
    rdfs:range cco:ont00001364 ;
    rdfs:subPropertyOf mro:ont00001904 ;
    skos:definition "x is measured by interval y =Def y is a interval measurement of x."@en ;
    cco:ont00001760 cco:ModalRelationOntology .

